{
  "manifest_version": 3,
  "name": "Tabolith",
  "version": "0.1.0",
  "description": "Vertical tab outliner: group tabs, drag and drop between groups, and keep everything across Chrome restarts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage", "unlimitedStorage", "favicon"],
  "background": { "service_worker": "src/background/background.js" },
  "commands": {
    "search-tabs": {
      "suggested_key": { "mac": "Alt+Shift+A", "default": "Alt+Shift+S" },
      "description": "Open Tabolith and search tabs"
    }
  },
  "action": {
    "default_title": "Open Tabolith window",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
