{
  "manifest_version": 3,
  "name": "Uber Tabs",
  "version": "1.0.0",
  "description": "Vertical tab outliner: group tabs, drag and drop between groups, and keep everything across Chrome restarts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage", "unlimitedStorage", "sidePanel", "favicon"],
  "background": { "service_worker": "src/background/background.js" },
  "side_panel": { "default_path": "src/sidepanel/panel.html" },
  "action": {
    "default_title": "Open Uber Tabs",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
